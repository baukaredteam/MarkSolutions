{
  "name": "@markflow/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "seed": "tsx src/seed.ts",
    "generate:pg": "prisma generate --schema prisma/pg/schema.prisma",
    "migrate:pg": "prisma migrate dev --schema prisma/pg/schema.prisma",
    "migrate:deploy:pg": "prisma migrate deploy --schema prisma/pg/schema.prisma",
    "migrate:status:pg": "prisma migrate status --schema prisma/pg/schema.prisma"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^6.0.0",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
