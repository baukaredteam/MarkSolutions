{
  "name": "@markflow/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate:dev": "node scripts/db-guard.mjs migrate-dev && prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "seed": "node scripts/db-guard.mjs seed && tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
