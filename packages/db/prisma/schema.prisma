// MarkFlow Prisma schema — канонический источник (W0-02R): PostgreSQL 16.
// Без enum (статусы String), без массивов (Json), деньги BigInt целыми тенге (дробных единиц нет),
// version для optimistic lock.
// SQLite как runtime-опция удалён (ADR-015 superseded); dev/test/stage/prod — PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id      String  @id @default(cuid())
  version Int     @default(0)
  name    String
  bin     String  @unique
  status  String  @default("PENDING") // PENDING|ACTIVE|REJECTED (ADR-016: String)
  accounts Account[]
  ledgerEntries LedgerEntry[]
  orders Order[]
  mptOrders MptOrder[]
  codeVaults CodeVault[]
  vaultExports VaultExport[]
  codeEvents CodeEvent[]
  ssscCounters SsscCounter[]
  utilisationReports UtilisationReport[]
  utilisationAlerts UtilisationAlert[]
  importDocuments ImportDocument[]
  withdrawalDocuments WithdrawalDocument[]
  invoices Invoice[]
  aggregationUnits AggregationUnit[]
  products  Product[]
  users     User[]
  productCards ProductCard[]
  draftProposals DraftProposal[]
  createdAt DateTime @default(now())
}

model Account {
  id      String  @id @default(cuid())
  version Int     @default(0)
  tenantId String
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  balance BigInt  @default(0) // тиыны (ADR-016 W5-07, 1 ₸ = 100 тиын); кэш, источник — LedgerEntry
  ledgerEntries LedgerEntry[]
  createdAt DateTime @default(now())
}

// Double-entry (ADR-007): источник истины баланса. balance = SUM(credit) - SUM(debit).
model LedgerEntry {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  kind      String   // TOPUP|RESERVE|RELEASE|SETTLE (ADR-007)
  amount    BigInt   // тиыны, положительное число
  refOrderId String? // связь с заказом (RESERVE/RELEASE/SETTLE)
  ref1c     String?  // идемпотентность PaymentImport (ADR-010)
  reason    String?
  createdAt DateTime @default(now())
  @@unique([ref1c])
  // C-05: ровно одна проводка вида на заказ (RESERVE/RELEASE/SETTLE идемпотентны
  // по (refOrderId, kind)); NULL refOrderId не конфликтует (SQLite/PG).
  @@unique([refOrderId, kind])
}

// Тариф на КМ (W3): данные в БД, не хардкод (дух ADR-012). Выбор = активный на дату.
model Tariff {
  id              String   @id @default(cuid())
  version         Int      @default(0)
  validFrom       DateTime
  validTo         DateTime
  pricePerCodeKZT BigInt   // тиыны за КМ (ADR-016 W5-07)
  unit            String   @default("KM")
  currency        String   @default("KZT")
  productGroup    String?  // W5-07: товарная группа (null = общий тариф)
  vatIncluded     Boolean  @default(true) // W5-07: цена включает НДС
  createdAt       DateTime @default(now())
}

// Счёт на оплату (W5-07): ISSUED|PAID|CANCELLED. number уникален (counter+retry).
model Invoice {
  id           String   @id @default(cuid())
  version      Int      @default(0)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  number       Int      @unique // MF-2026-NNNN (год+N)
  date         DateTime @default(now())
  productGroup String
  quantity     Int
  unitPrice    BigInt   // тиыны за КМ
  sumWithoutVat BigInt  // тиыны
  vat          BigInt   // тиыны
  sumWithVat   BigInt   // тиыны
  status       String   @default("ISSUED") // ISSUED|PAID|CANCELLED
  paymentRef   String?
  paidAt       DateTime?
  vatRatePct   Int      @default(16)
  createdAt    DateTime @default(now())
}

model Product {
  id      String  @id @default(cuid())
  version Int     @default(0)
  tenantId String
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  name    String
  tnved   String
  gtin    String?
  attributes Json? // 44 атрибута каталога (CATALOG-MM)
  demo    Boolean @default(false) // помечена "demo" (тикет 03)
  createdAt DateTime @default(now())
}

model User {
  id         String  @id @default(cuid())
  version    Int     @default(0)
  tenantId   String?
  tenant     Tenant? @relation(fields: [tenantId], references: [id])
  login      String  @unique
  passwordHash String
  roles      String  @default("[]") // JSON-массив ролей: admin, accountant, operator (ADR-016)
  mfaEnabled Boolean @default(false)
  createdAt  DateTime @default(now())
}

model Application {
  id             String   @id @default(cuid())
  version        Int      @default(0)
  bin            String   @unique
  name           String
  email          String
  phone          String
  city           String
  address        String
  contact        String
  // согласия-акцепт (ADR-003): версия документа, время, субъект
  consentDocument String
  consentAcceptedAt DateTime
  consentSubject   String
  // проверка 1ecom (ADR-004): Pending External + retry
  ecomStatus     String   @default("PENDING") // PENDING|PENDING_EXTERNAL|VERIFIED|REJECTED
  ecomRetries    Int      @default(0)
  status         String   @default("PENDING") // PENDING|NEEDS_CORRECTION|APPROVED|REJECTED (§8.1)
  operatorId     String?
  tenantId       String?
  createdAt      DateTime @default(now())
  approvedAt     DateTime?
}

model Outbox {
  id        String  @id @default(cuid())
  version   Int     @default(0)
  aggregate String
  payload   Json
  status    String  @default("PENDING") // PENDING|PROCESSING|PROCESSED|FAILED (ADR-016)
  createdAt DateTime @default(now())
  processedAt DateTime?
}

model ProductCard {
  id            String   @id @default(cuid())
  version       Int      @default(0)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  status        String   @default("DRAFT") // ModerationRoute (CAT-013): DRAFT|VALIDATING|SUBMITTED|IN_REVIEW|APPROVED|NEEDS_CORRECTION|REJECTED|REGISTERING|REGISTERED (ADR-016: String)
  gtin          String?
  ntin          String?
  attributes    Json     // 44 атрибута каталога (CATALOG-MM), schemaVersion внутри (ADR-021)
  audit         Json     @default("[]") // [{at, actor, action, comment}] — каждый переход модерации (CAT-013)
  fieldReasons  Json     @default("{}") // причины отклонения на уровне полей (CAT-013)
  rejectedAttributes Json? // снапшот атрибутов на момент реджекта (проверка исправления при resubmit)
  ordersBlocked Boolean  @default(false) // critical расхождение при сверке → блок НОВЫХ заказов КМ
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  drafts        DraftProposal[]
  // F1: partial unique index на (tenantId, gtin) WHERE "status" != 'ARCHIVED' (миграция t3_fix_partial_unique).
  // Дубль GTIN у tenant с активной карточкой — DB-гарантия (SQLite+PG) + app-проверка в $transaction.
  @@index([tenantId, gtin])
}

// GtinResolver (Q6): трёхслойный справочник GTIN (кэш → IG/GS1 → ручной ввод).
model GtinCache {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  gtin      String   @unique
  gcp       String?
  status    String   @default("PENDING_REAL") // VERIFIED|REJECTED|PENDING_REAL
  brand     String?
  source    String   @default("ig") // seed|ig|manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftProposal {
  id         String   @id @default(cuid())
  version    Int      @default(0)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  cardId     String?
  card       ProductCard? @relation(fields: [cardId], references: [id])
  source     String   // invoice|excel|form|clone|demo-seed
  proposed   Json     // предполагаемые поля + confidence (ADR-019)
  missing    Json     // список недостающего (ADR-019)
  status     String   @default("DRAFT") // DRAFT|DOBOR|OUT_OF_SCOPE (ADR-022)
  demo       Boolean  @default(false)
  audit      Json     @default("[]") // [{at, actor, action}] (Q3/Q4: решения аудируются)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Заказ КМ (W3, ADR-024): ORD-026 машина Draft->Validating->Funds Reserved->Queued->Sent->...
model Order {
  id           String   @id @default(cuid())
  version      Int      @default(0)
  number       Int      @unique @default(0) // UI-06a: уникальный номер (гонка max+1 → retry P2002)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  status       String   @default("DRAFT") // ORD-026: DRAFT|VALIDATING|FUNDS_RESERVED|QUEUED|SENT|ACCEPTED|PROCESSING|PARTIALLY_COMPLETED|COMPLETED|REJECTED|CANCELLED|FAILED
  idempotencyKey String  @unique
  cardId       String?
  gtin         String?
  isPaid       Boolean  @default(true)
  // C-04: бизнес-площадка нанесения (int32) — из заказа, не хардкод «1»
  businessPlaceId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lines        OrderLine[]
}

// Снимок единиц маркировки + тарифа (ADR-024): 1 заказ = 1 строка в MVP.
model OrderLine {
  id            String   @id @default(cuid())
  version       Int      @default(0)
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  cardId        String
  gtin          String
  places        Int
  unitsPerPlace Int
  quantity      Int      // 1 <= quantity <= places*unitsPerPlace
  totalPrice    BigInt   // тиыны = quantity * pricePerCodeKZT
  cisType       String   @default("UNIT")
  serialNumberType String @default("OPERATOR")
  tariffId      String
  pricePerCodeKZT BigInt  // снимок тарифа, тиыны (смена тарифа заказ не меняет)
}

// Симулятор ИС МПТ (W3, ADR-005/024): state в БД, статус = f(now, createdAt, SIM_MPT_EMISSION_MS).
model MptOrder {
  id          String   @id @default(cuid())
  version     Int      @default(0)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  externalId  String   @unique // orderId из POST /api/orders (внутренний заказ)
  gtin        String
  quantity    Int
  status      String   @default("CREATED") // CREATED|PENDING|READY|REJECTED|CLOSED (CONTRACT-IS-MPT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  codes       MptCode[]
}

// Коды симулятора (п.19 + ADR-006): структура {gtin, serial, ai91, ai92}, form base|extended.
model MptCode {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  mptOrderId String
  mptOrder  MptOrder @relation(fields: [mptOrderId], references: [id])
  gtin      String
  serial    String   // уникален по (gtin) между заказами (OPERATOR-генерация)
  ai91      String?
  ai92      String?
  form      String   @default("base") // base|extended (ADR-006)
  used      Boolean  @default(false) // нанесён (п.26) — повторное нанесение отклоняется
  createdAt DateTime @default(now())
  @@unique([gtin, serial])
}

// Отчёты о нанесении в симуляторе ИС МПТ (W3, п.26): stateless по SLA.
model MptUtilisation {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  reportId  String   @unique
  tenantId  String
  sntins    Json
  releaseType String
  expirationDate String
  productionDate String
  manufacturerCountry String
  businessPlaceId Int?  // C-04: площадка нанесения из заказа (трассировка)
  status    String   @default("IN_PROCESS") // IN_PROCESS|SUCCESS|ERROR
  rejectReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Code Vault (W3, CV-030..033): gtin ОТКРЫТЫЙ (индекс) + зашифрованный {serial,ai91,ai92}
// AES-256-GCM (per-row nonce рядом с ciphertext). Метадата открыта.
model CodeVault {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  orderId   String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  cardId    String?
  gtin      String   // открытый (публичный идентификатор, индекс)
  mask      String   // маска для UI/логов (CV-031)
  status    String   @default("ACTIVE") // MVP-набор (ADR-025): ACTIVE|PRINTED|APPLIED|UTILISED|INTRODUCED|EXPIRED|AGGREGATED|WITHDRAWN|WRITTEN_OFF
  ciphertext String  // base64: nonce(12) + GCM-tag(16) + encrypted(JSON {serial,ai91,ai92})
  labelKey  String?  // content-addressed key PNG DataMatrix (W4-02): повторная печать = тот же key
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    CodeEvent[]
  @@index([tenantId, gtin])
}

// Append-only лог статусов КМ (ADR-025): CodeVault.status = производная от последнего события.
// Write-through: статус обновляется при записи каждого события.
model CodeEvent {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  codeId    String
  code      CodeVault @relation(fields: [codeId], references: [id])
  event     String   // PRINTED|REPRINTED|APPLIED|AGGREGATED|DISAGGREGATED|UTILISED|INTRODUCED|EXPIRED|WITHDRAWN|WRITTEN_OFF
  at        DateTime @default(now())
  actor     String
  reasonCode String?
  comment   String?
  relatedId String?  // связанная сущность (агрегат, исходная печать)
  createdAt DateTime @default(now())
  @@index([tenantId, codeId])
  @@index([tenantId, event])
}

// Тенант-счётчик SSCC (ADR-025, Q4): auto-increment для генерации транспортных упаковок.
model SsscCounter {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nextSeq   Int      @default(1)
  createdAt DateTime @default(now())
  @@unique([tenantId])
}

// Аудит выдачи/печати КМ (CV-032): каждая выгрузка/печать фиксирует actor, время, основание, кол-во, orderId.
model VaultExport {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orderId   String
  actor     String
  kind      String   // export|print (CV-032)
  reason    String?
  count     Int
  createdAt DateTime @default(now())
}

// Отчёт о нанесении (W3, п.26): POST /api/utilisation → reportId; поллер доводит до SUCCESS/ERROR.
model UtilisationReport {
  id           String   @id @default(cuid())
  version      Int      @default(0)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  orderId      String
  idempotencyKey String  @unique
  reportId     String   @unique
  status       String   @default("IN_PROCESS") // IN_PROCESS|SUCCESS|ERROR (CONTRACT-IS-MPT)
  sntins       Json     // массив строк (base64 serial-идентификаторов КМ)
  releaseType  String   // PRODUCTION|IMPORT|CIRCULATION
  expirationDate String
  productionDate String
  manufacturerCountry String
  businessPlaceId String
  rejectReason String?
  settled      Boolean  @default(false) // SETTLE выполнен (п.26)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Таймер 30 дней (п.25, ADR-012): дедлайн = данные (срок 30, отсчёт от даты получения КМ).
// Алерты 7/3/1 — задачи оператору и видны tenant'у.
model UtilisationAlert {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orderId   String
  daysLeft  Int      // 7|3|1
  kind      String   // alert|expire
  status    String   @default("OPEN") // OPEN|RESOLVED
  firedAt   DateTime? // момент отправки уведомления (Q10: исключения = незакрытые алерты)
  createdAt DateTime @default(now())
}

// ДТ на партию (W4-04, Q5): одна ДТ на заказ; после SUCCESS — INTRODUCED по всем кодам.
// unique(tenantId, customsDeclaration.number) → 409 при повторе.
model ImportDocument {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orderId   String
  customsDate   String   // дата ДТ (customsDeclaration.date)
  customsNumber String   // номер ДТ (customsDeclaration.number)
  authorityCode String?  // customsDeclaration.authorityCode
  status    String   @default("EXPECTED") // EXPECTED|SUBMITTED|SUCCESS|ERROR
  rejectReason String?
  externalDocumentId String?
  createdAt DateTime @default(now())
  submittedAt DateTime?
  @@unique([tenantId, customsNumber])
}

// Вывод из оборота (W4-04, Q9): WITHDRAWAL→WITHDRAWN, WRITE_OFF→WRITTEN_OFF.
// Async state machine (тикет MPT-02): SUBMITTED → (поллер getDocument) → SUCCESS/ERROR.
// Локальные CodeEvent/статусы Vault пишутся ТОЛЬКО после внешнего SUCCESS.
model WithdrawalDocument {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  codes     Json     // массив codeId (или codeKeys)
  withdrawalType String // WITHDRAWAL|WRITE_OFF
  withdrawalReason String // DEFECT|LOST|EXPIRY|RETURN_SUPPLIER|DESTRUCTION|OTHER
  comment   String?
  childrenWriteOff Boolean @default(false)
  primaryDocument Json?  // {type,date,number}
  // снимок развёрнутых агрегатов на момент submit (для DISAGGREGATED после SUCCESS)
  aggregateUnits Json?  // string[] unitId
  externalDocumentId String? // внешний documentId ИС МПТ (async reconciliation)
  status    String   @default("SUBMITTED") // SUBMITTED|SUCCESS|ERROR
  rejectReason String?
  createdAt DateTime @default(now())
  submittedAt DateTime?
}

// Документы симулятора ИС МПТ (W4-04): import/withdrawal, stateless по SLA.
model MptDocument {
  id           String   @id @default(cuid())
  documentId   String   @unique
  tenantId     String
  kind         String   // import|withdrawal
  codes        Json     // массив codeKey
  payload      Json?    // тип/причина и пр.
  status       String   @default("IN_PROCESS") // IN_PROCESS|SUCCESS|ERROR
  rejectReason String?
  createdAt    DateTime @default(now())
}

// Агрегация (W4-03/04, ADR-025): транспортная упаковка SSCC. Для childrenWriteOff.
model AggregationUnit {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sscc      String   @unique
  type      String   // BOX_LV_1|BOX_LV_2|PALLET
  parentId  String?
  status    String   @default("OPEN") // OPEN|SEALED|DISAGGREGATED
  sealedAt  DateTime?
  createdAt DateTime @default(now())
  members   AggregationMember[]
}

model AggregationMember {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  unitId    String
  unit      AggregationUnit @relation(fields: [unitId], references: [id])
  tenantId  String
  codeKey   String
  addedAt   DateTime @default(now())
  addedBy   String
  @@unique([unitId, codeKey])
}
