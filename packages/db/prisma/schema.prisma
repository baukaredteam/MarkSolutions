// MarkFlow Prisma schema — портабельная (ADR-016): SQLite dev / PostgreSQL prod.
// Без enum (статусы String), без массивов (Json), деньги BigInt минорными,
// version для optimistic lock.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id      String  @id @default(cuid())
  version Int     @default(0)
  name    String
  bin     String  @unique
  status  String  @default("PENDING") // PENDING|ACTIVE|REJECTED (ADR-016: String)
  accounts Account[]
  ledgerEntries LedgerEntry[]
  products  Product[]
  users     User[]
  productCards ProductCard[]
  draftProposals DraftProposal[]
  createdAt DateTime @default(now())
}

model Account {
  id      String  @id @default(cuid())
  version Int     @default(0)
  tenantId String
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  balance BigInt  @default(0) // минорные единицы (ADR-016); материализованный кэш, источник истины — LedgerEntry
  ledgerEntries LedgerEntry[]
  createdAt DateTime @default(now())
}

// Double-entry (ADR-007): источник истины баланса. balance = SUM(credit) - SUM(debit).
model LedgerEntry {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  kind      String   // TOPUP|RESERVE|RELEASE|SETTLE (ADR-007)
  amount    BigInt   // минорные единицы, положительное число
  refOrderId String? // связь с заказом (RESERVE/RELEASE/SETTLE)
  ref1c     String?  // идемпотентность PaymentImport (ADR-010)
  reason    String?
  createdAt DateTime @default(now())
  @@unique([ref1c])
}

// Тариф на КМ (W3): данные в БД, не хардкод (дух ADR-012). Выбор = активный на дату.
model Tariff {
  id              String   @id @default(cuid())
  version         Int      @default(0)
  validFrom       DateTime
  validTo         DateTime
  pricePerCodeKZT BigInt   // минорные (тийыны)
  unit            String   @default("KM")
  currency        String   @default("KZT")
  createdAt       DateTime @default(now())
}

model Product {
  id      String  @id @default(cuid())
  version Int     @default(0)
  tenantId String
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  name    String
  tnved   String
  gtin    String?
  attributes Json? // 44 атрибута каталога (CATALOG-MM)
  demo    Boolean @default(false) // помечена "demo" (тикет 03)
  createdAt DateTime @default(now())
}

model User {
  id         String  @id @default(cuid())
  version    Int     @default(0)
  tenantId   String?
  tenant     Tenant? @relation(fields: [tenantId], references: [id])
  login      String  @unique
  passwordHash String
  roles      String  @default("[]") // JSON-массив ролей: admin, accountant, operator (ADR-016)
  mfaEnabled Boolean @default(false)
  createdAt  DateTime @default(now())
}

model Application {
  id             String   @id @default(cuid())
  version        Int      @default(0)
  bin            String   @unique
  name           String
  email          String
  phone          String
  city           String
  address        String
  contact        String
  // согласия-акцепт (ADR-003): версия документа, время, субъект
  consentDocument String
  consentAcceptedAt DateTime
  consentSubject   String
  // проверка 1ecom (ADR-004): Pending External + retry
  ecomStatus     String   @default("PENDING") // PENDING|PENDING_EXTERNAL|VERIFIED|REJECTED
  ecomRetries    Int      @default(0)
  status         String   @default("PENDING") // PENDING|NEEDS_CORRECTION|APPROVED|REJECTED (§8.1)
  operatorId     String?
  tenantId       String?
  createdAt      DateTime @default(now())
  approvedAt     DateTime?
}

model Outbox {
  id        String  @id @default(cuid())
  version   Int     @default(0)
  aggregate String
  payload   Json
  status    String  @default("PENDING") // PENDING|PROCESSING|PROCESSED|FAILED (ADR-016)
  createdAt DateTime @default(now())
  processedAt DateTime?
}

model ProductCard {
  id            String   @id @default(cuid())
  version       Int      @default(0)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  status        String   @default("DRAFT") // ModerationRoute (CAT-013): DRAFT|VALIDATING|SUBMITTED|IN_REVIEW|APPROVED|NEEDS_CORRECTION|REJECTED|REGISTERING|REGISTERED (ADR-016: String)
  gtin          String?
  ntin          String?
  attributes    Json     // 44 атрибута каталога (CATALOG-MM), schemaVersion внутри (ADR-021)
  audit         Json     @default("[]") // [{at, actor, action, comment}] — каждый переход модерации (CAT-013)
  fieldReasons  Json     @default("{}") // причины отклонения на уровне полей (CAT-013)
  rejectedAttributes Json? // снапшот атрибутов на момент реджекта (проверка исправления при resubmit)
  ordersBlocked Boolean  @default(false) // critical расхождение при сверке → блок НОВЫХ заказов КМ
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  drafts        DraftProposal[]
  // F1: partial unique index на (tenantId, gtin) WHERE "status" != 'ARCHIVED' (миграция t3_fix_partial_unique).
  // Дубль GTIN у tenant с активной карточкой — DB-гарантия (SQLite+PG) + app-проверка в $transaction.
  @@index([tenantId, gtin])
}

// GtinResolver (Q6): трёхслойный справочник GTIN (кэш → IG/GS1 → ручной ввод).
model GtinCache {
  id        String   @id @default(cuid())
  version   Int      @default(0)
  gtin      String   @unique
  gcp       String?
  status    String   @default("PENDING_REAL") // VERIFIED|REJECTED|PENDING_REAL
  brand     String?
  source    String   @default("ig") // seed|ig|manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftProposal {
  id         String   @id @default(cuid())
  version    Int      @default(0)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  cardId     String?
  card       ProductCard? @relation(fields: [cardId], references: [id])
  source     String   // invoice|excel|form|clone|demo-seed
  proposed   Json     // предполагаемые поля + confidence (ADR-019)
  missing    Json     // список недостающего (ADR-019)
  status     String   @default("DRAFT") // DRAFT|DOBOR|OUT_OF_SCOPE (ADR-022)
  demo       Boolean  @default(false)
  audit      Json     @default("[]") // [{at, actor, action}] (Q3/Q4: решения аудируются)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
