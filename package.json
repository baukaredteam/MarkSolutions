{
  "name": "markflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "secret-scan": "node scripts/secret-scan.mjs",
    "dev": "npm run dev --workspace @markflow/api",
    "db:generate": "npm run generate --workspace @markflow/db",
    "db:migrate": "npm run migrate --workspace @markflow/db",
    "db:seed": "npm run seed --workspace @markflow/db",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.9",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
