{
  "name": "markflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "secret-scan": "node scripts/secret-scan.mjs",
    "dev": "npm run dev --workspace @markflow/api",
    "db:generate": "npm run generate --workspace @markflow/db",
    "db:migrate:dev": "npm run migrate:dev --workspace @markflow/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace @markflow/db",
    "db:migrate:status": "npm run migrate:status --workspace @markflow/db",
    "db:seed": "npm run seed --workspace @markflow/db",
    "db:bootstrap:dev": "npm install && npm run db:generate && npm run db:migrate:dev && npm run db:seed && npm run build:cjs --workspace @markflow/shared",
    "db:validate": "node scripts/db-validate.mjs",
    "verify": "npm run db:generate && npm run build:cjs --workspace @markflow/shared && npm run typecheck && npm run lint && npm run secret-scan && npm test",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "prepare": "husky",
    "predev": "npm run build:cjs --workspace @markflow/shared",
    "prestart": "npm run build:cjs --workspace @markflow/shared"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.9",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.4",
    "@sec-ant/zxing-wasm": "^2.2.0",
    "bwip-js": "^4.11.2"
  }
}
