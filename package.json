{
  "name": "markflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "secret-scan": "node scripts/secret-scan.mjs",
    "dev": "npm run dev --workspace @markflow/api",
    "db:generate": "npm run generate --workspace @markflow/db",
    "db:migrate": "npm run migrate --workspace @markflow/db",
    "db:seed": "npm run seed --workspace @markflow/db",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
