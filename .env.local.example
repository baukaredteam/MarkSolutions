# W0-03: Local stack placeholder variable names.
# Actual values are generated at first start into .env.local (gitignored).
# NEVER commit real passwords, tokens, or credentials.

# PostgreSQL
LOCAL_PG_PASSWORD=CHANGEME

# MinIO
LOCAL_MINIO_ACCESS_KEY=CHANGEME
LOCAL_MINIO_SECRET_KEY=CHANGEME

# OpenBao (generated at first start; used as -dev-root-token-id)
LOCAL_OPENBAO_ROOT_TOKEN=CHANGEME
