# === Database ===
# W0-02R: PostgreSQL is the single canonical database for dev/test/stage/prod.
# SQLite is no longer a runtime option.

# Development: local PostgreSQL 16.
DATABASE_URL="postgresql://markflow:markflow@localhost:5432/markflow_dev"

# Stage/Production: PostgreSQL 16. Required for production profiles.
# DATABASE_URL="postgresql://<user>:<pass>@<host>:5432/markflow"

# Test: disposable PostgreSQL for CI/validation. Must contain the "markflow_test" marker
# unless ALLOW_TEST_DB_RESET=true. The shared test harness creates an isolated schema under it.
# TEST_DATABASE_URL="postgresql://markflow:markflow@localhost:5432/markflow_test"

# === Auth (T1) ===
JWT_SECRET="dev-secret"
# IAM-006 заглушка: при "true" обязательные роли (admin/accountant/operator) требуют второй фактор
MFA_ENABLED="false"

# === Seed safety ===
# Set to "true" only in development to allow seed against non-test databases
# SEED_ENABLED="false"

# --- ИС МПТ (HttpMptAdapter, C-01): переключение через ADAPTERS_MPT ---
# "mock" = симулятор (по умолчанию); "http" = реальный контур test.markirovka.kz / prod
ADAPTERS_MPT="mock"
# Серверные credentials (в браузер НЕ уходят):
# MPT_BASE_URL="https://test.markirovka.kz"
# MPT_LOGIN=""
# MPT_PASSWORD=""
# Параметры провода (деплой-настройка):
# MPT_PRODUCT_GROUP="motor-oils"
# MPT_BUSINESS_PLACE_ID=""
# MPT_MAX_RETRIES="2"
# MPT_REQUEST_TIMEOUT_MS="15000"

# --- Прод-инфраструктура (docker-compose.infra.yml) ---
# Valkey (блокировки/идемпотентность/кэш)
REDIS_URL="redis://localhost:6379"

# RabbitMQ (outbox, документы ИС МПТ, Saga)
RABBITMQ_URL="amqp://markflow:markflow@localhost:5672"

# MinIO (экспорты кодов, audit-логи, payload документов)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="markflow"
MINIO_SECRET_KEY="markflow123"
MINIO_BUCKET="markflow-codes"
MINIO_USE_SSL="false"

# KMS: dev = file-KMS, прод = OpenBao
KMS_PROFILE="file"
KMS_FILE_DIR="./kms-keys"
KMS_OPENBAO_ADDR="http://localhost:8200"
# dev-токен из infra/openbao/init.sh (root token в openbao-data volume);
# прод — отдельный токен с политикой минимум-прав
KMS_OPENBAO_TOKEN="dev-token-change-me"
